# Build base: / for a subdomain, /sembrador/ for a subdirectory.
VITE_BASE_PATH=/
# Development PHP target; set these variables in the process environment.
SEMBRADOR_API_TARGET=http://localhost/sembrador
# PHP-only settings (never prefix these with VITE_):
# SEMBRADOR_DATA_DIR=/var/lib/el-sembrador
# SEMBRADOR_INITIAL_PIN=<six private digits chosen at installation>
